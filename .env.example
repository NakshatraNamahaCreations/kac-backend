PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/gigkaar

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS origin for the Expo web target. Comma-separated for multiple origins.
CORS_ORIGIN=http://localhost:8081

# Optional — real Razorpay order creation. Without these, payment endpoints
# return mock order ids so the app is still demoable end-to-end.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dev-only: skip real SMS delivery and always accept this OTP code.
DEV_OTP_CODE=123456
